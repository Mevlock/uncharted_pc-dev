// bbport: Uncharted 2's scene HDR (gpu/hdr/README.md) in the port's upscaled frame.
// MODE 0 (after the upscale of the HDR scene, `scene` linear, 1.0 = the game's white): the 8-bit
//   frame the HUD draws into (`sdr`, stored values: the scene clipped at white) and, in place, the
//   scene in the presenter's domain (above 1.0 the value whose sRGB encoding, shown at gamma 2.2,
//   gives the scene's own; equal below).
// MODE 1 (at the flip): the frame shown. `shown` is the 8-bit frame with the HUD; where it equals
//   the frame before the HUD (recomputed from `scene`) the HDR scene shows; HUD pixels keep it
//   under their coverage, estimated from the brightness change (a dark overlay: shown / before,
//   a light one: 1 - (shown - before) / (1 - before)), so fades and dimmed menus dim the HDR scene
//   instead of cutting it to SDR.
#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform image2D scene;
#if MODE == 0
layout(binding = 1, rgba8) uniform writeonly image2D sdr;
#else
layout(binding = 1, rgba8) uniform readonly image2D shown;
layout(binding = 2, rgba16f) uniform writeonly image2D target;
#endif

vec3 Encode(vec3 v) {
    v = max(v, 0.0);
    return mix(1.055 * pow(v, vec3(1.0 / 2.4)) - 0.055, v * 12.92, lessThan(v, vec3(0.0031308)));
}

vec3 Decode(vec3 v) {
    v = max(v, 0.0);
    return mix(pow((v + 0.055) / 1.055, vec3(2.4)), v / 12.92, lessThanEqual(v, vec3(0.04045)));
}

float Luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(scene)))) {
        return;
    }
#if MODE == 0
    vec3 h = imageLoad(scene, pixel).rgb;
    h = mix(max(h, 0.0), vec3(0.0), isnan(h)); // NaN from the upscaler: black
    imageStore(sdr, pixel, vec4(Encode(min(h, vec3(1.0))), 1.0));
    const vec3 presented = mix(h, Decode(pow(h, vec3(1.0 / 2.2))), greaterThan(h, vec3(1.0)));
    imageStore(scene, pixel, vec4(presented, 1.0));
#else
    const vec3 h = imageLoad(scene, pixel).rgb;
    const vec3 d = Decode(imageLoad(shown, pixel).rgb);
    const vec3 s = Decode(round(clamp(Encode(min(h, vec3(1.0))), 0.0, 1.0) * 255.0) / 255.0);
    const float dy = Luma(d), sy = Luma(s);
    float w;
    if (dy <= sy) {
        w = sy > 1e-5 ? dy / sy : 1.0;
    } else {
        w = sy < 1.0 - 1e-5 ? 1.0 - (dy - sy) / (1.0 - sy) : 0.0;
    }
    w = clamp(w, 0.0, 1.0);
    imageStore(target, pixel, vec4(max(d + (h - s) * w, 0.0), 1.0));
#endif
}

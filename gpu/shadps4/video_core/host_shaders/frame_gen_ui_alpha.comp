// bbport (DLSS rework 9): the UI's coverage for DLSS Frame Generation (pUIAlpha): 1 where the
// finished frame differs from the same frame composed without its UI, 0 elsewhere (as
// frame_gen_ui.comp decides it for FSR 3.1).
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, r8) uniform writeonly image2D alpha_img;
layout(binding = 1) uniform texture2D color_tex;   // the finished frame
layout(binding = 2) uniform texture2D hudless_tex; // the same frame without its UI

layout(push_constant) uniform Constants {
    ivec2 size;
};

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }
    const vec3 difference = abs(texelFetch(color_tex, pixel, 0).rgb - texelFetch(hudless_tex, pixel, 0).rgb);
    const float ui = max(difference.r, max(difference.g, difference.b)) > 1.5 / 255.0 ? 1.0 : 0.0;
    imageStore(alpha_img, pixel, vec4(ui));
}
